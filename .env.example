VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-key"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# Optional feature flags (leave empty/0 to disable)
# VITE_DEMO_MODE=false
# VITE_DEV_SMOKE=0
# VITE_ADMIN_TUNING=0
# VITE_EVIDENCE_DEBUG=0

# ── .env.staging (gitignored) — schema only, values blank. Used by
#    `npm run test:isolation`, `npm run preflight:staging` and scripts/qa/*.
#    SUPABASE_URL must contain the staging ref jhipmqdpjenojfhfjgzq or every
#    harness hard-aborts (they can never target production).
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# TEST_USER_A_EMAIL=
# TEST_USER_A_ID=
# TEST_USER_B_EMAIL=
# TEST_USER_B_ID=
# TEST_USER_PASSWORD=
